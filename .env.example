# Supabase project settings -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Absolute site URL used in confirmation / password-reset emails.
# Local: http://localhost:3000   Production: https://your-site.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Best-effort DNS check that rejects signup domains that cannot receive mail.
# Set to "off" in environments without outbound DNS (it fails open regardless).
AUTH_EMAIL_DNS_CHECK=on

# --- Make email verification real (scripts/configure-auth.mjs) ----------------
# The app blocks email/password signup while Supabase auto-confirms addresses.
# Fill these in, then run: npm run auth:configure -- --dry-run
#
# Personal access token: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=
# Optional; derived from NEXT_PUBLIC_SUPABASE_URL when omitted.
# SUPABASE_PROJECT_REF=ormodcniraaxctqdxunz
#
# Any SMTP provider works (SendGrid, Brevo, Resend, Postmark, SES). If you do
# not own a domain, verify a single sender address with the provider first.
# AUTH_SMTP_HOST=smtp.sendgrid.net
# AUTH_SMTP_PORT=587
# AUTH_SMTP_USER=apikey
# AUTH_SMTP_PASS=
# AUTH_SMTP_FROM=you@example.com
# AUTH_SMTP_SENDER_NAME=SplitNest
# AUTH_SITE_URL=https://splitnest-payments.netlify.app
# AUTH_REDIRECT_URLS=https://splitnest-payments.netlify.app/auth/confirm,http://localhost:3000/auth/confirm
#
# Optional Google provider. With these set you can run:
#   npm run auth:configure -- --google-only
# to enable Google sign-in without SMTP. Email signup stays blocked until the
# normal mode (Confirm email + SMTP) is configured.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
